# ============================================================
# Docker Compose 环境变量模板
# 使用方式：复制本文件为 .env，填写实际值
#   cp .env.example .env
# ⚠️ .env 文件已加入 .gitignore，不会提交到 Git
# ============================================================

# ==================== 数据库 ====================
MYSQL_ROOT_PASSWORD=replace-with-your-database-password
MYSQL_DATABASE=shijiang

# ==================== JWT 安全 ====================
# 生产环境必须修改！建议用 openssl rand -hex 32 生成
JWT_SECRET_KEY=replace-with-your-own-random-secret

# ==================== AI 配置 ====================
# 从 https://dashscope.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=

AI_ENABLED=true
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com
VIDEO_SEARCH_ENABLED=true
VIDEO_SEARCH_CACHE_HOURS=24
AI_PROVIDER=dashscope
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_AUDIO_MODEL=qwen-omni-turbo
DASHSCOPE_VISION_MODEL=qwen-vl-max

# ==================== 视频分析 ====================
VIDEO_ANALYSIS_PROVIDER=dashscope
ENABLE_GESTURE_ANALYSIS=true
USE_CLOUD_VISION=true

# ==================== CORS 跨域 ====================
# 生产环境填写你的实际域名，JSON 数组格式
# 本地测试：CORS_ORIGINS=["http://localhost","http://localhost:80"]
# 生产服务器：CORS_ORIGINS=["https://yourdomain.com","http://your-server-ip"]
CORS_ORIGINS=["http://localhost","http://localhost:80","http://127.0.0.1"]

# ==================== 其他可选 ====================
DEBUG=false
HTTP_PORT=80
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_FILE_SIZE=524288000
