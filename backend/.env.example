# Local backend template. Copy to .env and fill in your own values.
DATABASE_URL=sqlite+aiosqlite:///./app.db
DATABASE_ECHO=false
DEBUG=false
JWT_SECRET_KEY=replace-with-your-own-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIR=./uploads
TEXTBOOK_STORAGE_DIR=./private_textbooks
TRIAL_VIDEO_STORAGE_DIR=./private_trial_videos
# Empty uses the project-root 音频源文件 directory.
AUDIO_SOURCE_DIR=
AI_ENABLED=false
AI_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_AUDIO_MODEL=qwen-omni-turbo
DASHSCOPE_VISION_MODEL=qwen-vl-max
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com
VIDEO_SEARCH_ENABLED=true
VIDEO_ANALYSIS_PROVIDER=dashscope
ENABLE_GESTURE_ANALYSIS=true
USE_CLOUD_VISION=true
